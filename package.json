{
  "name": "copperpot-store-connect",
  "version": "0.9.0",
  "private": true,
  "description": "Store Systems edge service: POS adapter, kitchen display feed, per-store order throttling.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm ci --no-audit --no-fund && node scripts/setup.mjs",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.1",
    "pino": "^9.3.2",
    "prom-client": "^15.1.3",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "prettier": "^3.3.3",
    "socket.io-client": "^4.7.5",
    "tsx": "^4.17.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.1.0",
    "vitest": "^5.0.5"
  }
}
