{
  "name": "copperpot-store-connect",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/terraform:1": { "version": "1.8" }
  },
  "forwardPorts": [8080, 6379, 4318],
  "portsAttributes": {
    "8080": { "label": "store-connect" },
    "6379": { "label": "redis" }
  },
  "postCreateCommand": "npm run setup",
  "postStartCommand": "docker compose up -d redis",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer",
        "hashicorp.terraform"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },
  "remoteUser": "node"
}
