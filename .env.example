# Copperpot store-connect: local configuration. Copy to .env (npm run setup does this).
# Every variable the service reads is listed here with its default.

# HTTP listener for /health, /ready, /metrics and the throttle routes
PORT=8080
HOST=0.0.0.0

# Logging: pino levels (trace, debug, info, warn, error)
LOG_LEVEL=info

# Reported in every log line, in /health and in the resource attributes of traces.
# The promotion tooling sets it to the release tag; local runs say "local".
SERVICE_VERSION=local

# Throttle state: "memory" for a single process, "redis" for the fleet edge
THROTTLE_STORE=memory
REDIS_URL=redis://localhost:6379
# Default bucket per store: capacity (orders in flight) and refill per minute
THROTTLE_CAPACITY=20
THROTTLE_REFILL_PER_MINUTE=12
# Per-store overrides, comma separated: storeId:capacity:refillPerMinute
THROTTLE_OVERRIDES=

# Commerce API the adapter posts orders to (the store application)
COMMERCE_API_URL=http://localhost:4100/store
COMMERCE_API_KEY=
COMMERCE_TIMEOUT_MS=2500

# POS event source: "stub" emits synthetic events on an interval; "feed" reads the POS gateway
POS_MODE=stub
POS_STUB_INTERVAL_MS=4000
POS_STUB_STORES=101,102,103

# Kitchen display feed (Socket.IO path)
KDS_PATH=/kds

# Tracing: OTLP over HTTP; leave the endpoint empty to disable the exporter
OTEL_SERVICE_NAME=store-connect
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
